# NEXO — copie para .env.local (ignorado pelo Git). NUNCA coloque chaves reais neste arquivo.
NEXO_ENV=development
NEXO_APP_URL=http://localhost:3000

# Banco: pglite (local, sem Docker) ou postgres (Supabase/Postgres gerenciado)
NEXO_DB_DRIVER=pglite
NEXO_PGLITE_DIR=./.data/pglite
# DATABASE_URL=postgresql://postgres:<senha>@<host>:5432/postgres

# Autenticação: local (somente dev/teste) ou supabase
NEXO_AUTH_PROVIDER=local
# Verificação de e-mail no cadastro: off (provisório — conta criada já entra) | required (envia link de confirmação).
# Com Supabase, alinhar com "Confirm email" em Authentication > Providers > Email. Ver ADR-020.
NEXO_EMAIL_VERIFICATION=off
NEXO_SESSION_SECRET=<gere-com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
# SUPABASE_URL=https://<projeto>.supabase.co
# SUPABASE_ANON_KEY=<chave-publica>
# SUPABASE_JWT_SECRET=<somente se usar chave HS256 legada>

# Dados sintéticos de desenvolvimento (proibido em produção)
NEXO_SEED_SYNTHETIC=1

# OpenAI — chamadas pagas desativadas por padrão; habilitar somente com autorização dos sócios.
# OPENAI_API_KEY=<chave>
OPENAI_ALLOW_PAID_CALLS=false

# Asaas — usar sandbox. Produção exige ASAAS_ALLOW_PRODUCTION=true e autorização explícita.
# ASAAS_API_KEY=<chave-sandbox>
ASAAS_ENV=sandbox
# ASAAS_WEBHOOK_TOKEN=<token-configurado-no-painel-asaas>
ASAAS_ALLOW_PRODUCTION=false

# Jobs agendados (reconciliação, gêmeas, alertas)
# CRON_SECRET=<segredo-longo>

# Cloudflare R2 (imagens de questões/materiais)
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
