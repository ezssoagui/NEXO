# Backend NEXO V1 Comercial (server/). NUNCA coloque chaves em variáveis VITE_*: elas iriam para o navegador.
PORT=8787
NEXO_ALLOWED_ORIGIN=http://localhost:5173
NEXO_DB_PATH=server/data/nexo.db
NEXO_ASSETS_DIR=server/data/assets

# Provedores de IA Multi-LLM (ordem de prioridade/fallback: anthropic, gemini, openai)
NEXO_AI_PROVIDERS=anthropic,gemini,openai
ANTHROPIC_API_KEY=
NEXO_ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
NEXO_GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
NEXO_OPENAI_MODEL=gpt-4o-mini

# Gateway de Pagamento (local = simulador controlado para V1; futuro: asaas | pagarme | stripe)
NEXO_PAYMENT_GATEWAY=local

# Administração & Privacidade (LGPD)
NEXO_ADMIN_CODE=nexo-admin-dev
NEXO_LOG_SALT=troque-este-valor-em-producao
