# Backend de IA da NEXO (server/). NUNCA coloque chaves em variáveis VITE_*: elas iriam para o navegador.
ANTHROPIC_API_KEY=
NEXO_AI_PROVIDER=anthropic
NEXO_AI_MODEL=claude-opus-5-5
PORT=8787
NEXO_ALLOWED_ORIGIN=http://localhost:5173
# Limites por usuário/dia e orçamento mensal da plataforma
NEXO_LIMIT_TUTOR_DAY=60
NEXO_LIMIT_ESSAY_DAY=4
NEXO_LIMIT_QUESTIONS_DAY=10
NEXO_TOKENS_USER_DAY=150000
NEXO_MONTHLY_BUDGET_USD=50
# Sal para pseudonimizar ids nos logs
NEXO_LOG_SALT=troque-este-valor
# Front-end: auto | demo | remote
VITE_AI_MODE=auto
